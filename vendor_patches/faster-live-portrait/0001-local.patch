diff --git a/src/pipelines/faster_live_portrait_pipeline.py b/src/pipelines/faster_live_portrait_pipeline.py
index 9031fc3..3f2595d 100644
--- a/src/pipelines/faster_live_portrait_pipeline.py
+++ b/src/pipelines/faster_live_portrait_pipeline.py
@@ -112,7 +112,8 @@ class FasterLivePortraitPipeline:
 
     def calc_combined_eye_ratio(self, c_d_eyes_i, source_lmk):
         c_s_eyes = calc_eye_close_ratio(source_lmk[None])
-        c_d_eyes_i = np.array(c_d_eyes_i).reshape(1, 1)
+        # camera path passes per-eye ratios (2 values); the retarget slot expects one scalar -> mean
+        c_d_eyes_i = np.array(c_d_eyes_i, dtype=np.float32).mean().reshape(1, 1)
         # [c_s,eyes, c_d,eyes,i]
         combined_eye_ratio_tensor = np.concatenate([c_s_eyes, c_d_eyes_i], axis=1)
         return combined_eye_ratio_tensor
@@ -342,7 +343,18 @@ class FasterLivePortraitPipeline:
                     if self.is_source_video:
                         R_new = self.R_d_smooth.process(R_d_i)
                     else:
-                        R_new = (R_d_i @ np.transpose(R_d_0, (0, 2, 1))) @ R_s
+                        R_rel = R_d_i @ np.transpose(R_d_0, (0, 2, 1))
+                        # cartoon puppeteering: a single drawing has no 3D info for large head
+                        # rotations (looking up smears the neck/face) -> clamp total relative
+                        # rotation via axis-angle. Knob: infer_params.max_head_rot_deg.
+                        lim_deg = float(self.cfg.infer_params.get("max_head_rot_deg", 0) or 0)
+                        if lim_deg > 0:
+                            rvec, _ = cv2.Rodrigues(R_rel[0].astype(np.float64))
+                            ang = float(np.linalg.norm(rvec))
+                            lim = np.deg2rad(lim_deg)
+                            if ang > lim:
+                                R_rel = cv2.Rodrigues(rvec * (lim / ang))[0][None].astype(R_rel.dtype)
+                        R_new = R_rel @ R_s
                 else:
                     R_new = R_s
 
@@ -457,7 +469,9 @@ class FasterLivePortraitPipeline:
                         lip_delta = self.retarget_lip(x_s, combined_lip_ratio_tensor)
 
                     if self.cfg.infer_params.flag_relative_motion:  # use x_s
-                        x_d_i_new = x_s + \
+                        # puppeteering patch: keep full driving motion (mouth/head) and ADD the
+                        # retarget deltas on top, instead of replacing motion with the static source.
+                        x_d_i_new = x_d_i_new + \
                                     (eyes_delta.reshape(-1, x_s.shape[1], 3) if eyes_delta is not None else 0) + \
                                     (lip_delta.reshape(-1, x_s.shape[1], 3) if lip_delta is not None else 0)
                     else:  # use x_d,i

