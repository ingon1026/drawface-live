+++ b/live.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# LivePortrait 실시간 퍼펫 — 사용법: ./live.sh [그림경로]   (기본: assets/test/girl.jpg)
+# 창에서 Q = 종료. 자세한 건 README_LOCAL.md
+set -e
+cd "$(dirname "$0")"
+
+SRC="${1:-assets/test/girl.jpg}"
+[ -f "$SRC" ] || { echo "그림이 없습니다: $SRC"; exit 1; }
+# 리포 밖 경로(바탕화면 등)면 컨테이너가 볼 수 있게 assets/test/ 로 복사
+case "$(realpath "$SRC")" in
+  "$PWD"/*) : ;;
+  *) cp "$SRC" "assets/test/_input.${SRC##*.}"; SRC="assets/test/_input.${SRC##*.}";;
+esac
+
+# 카메라가 WSL에 없으면 attach 시도 (RealSense D455, Shared 상태 전제)
+if [ ! -e /dev/video4 ]; then
+  echo "카메라 attach 시도…"
+  usbipd.exe attach --wsl --busid 2-1 || {
+    echo "실패 — PowerShell(관리자)에서: usbipd bind --busid 2-1 후 다시 실행"; exit 1; }
+  sleep 2
+fi
+
+exec docker run --rm --gpus=all --name flp_live \
+  -v "$PWD:/root/FLP" \
+  --device /dev/video4:/dev/video0 \
+  -e DISPLAY=:0 -v /mnt/wslg/.X11-unix:/tmp/.X11-unix \
+  shaoguo/faster_liveportrait:v3 \
+  bash -c "export LD_LIBRARY_PATH=/opt/TensorRT-8.6.1.6/lib:\$LD_LIBRARY_PATH; \
+    apt-get install -y -q libsm6 libice6 >/dev/null 2>&1; \
+    /root/miniconda3/bin/pip install -q colorama ffmpeg-python omegaconf tqdm 2>/dev/null; \
+    cd /root/FLP && /root/miniconda3/bin/python run.py \
+      --src_image '$SRC' --dri_video 0 \
+      --cfg configs/trt_infer_eyes.yaml --realtime --paste_back"
