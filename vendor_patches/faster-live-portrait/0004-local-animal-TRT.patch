FLP docker 이미지 안에서 `python` 이 PATH 에 없어 all_onnx2trt.sh 는 2a455de 에서
/root/miniconda3/bin/python 으로 고쳤는데 animal 변형만 빠져 있었음. 동일하게 적용.
---
 scripts/all_onnx2trt_animal.sh | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/scripts/all_onnx2trt_animal.sh b/scripts/all_onnx2trt_animal.sh
index 741f43b..22e7d75 100644
--- a/scripts/all_onnx2trt_animal.sh
+++ b/scripts/all_onnx2trt_animal.sh
@@ -1,12 +1,12 @@
 #!/bin/bash
 
 # warping+spade model
-python scripts/onnx2trt.py -o ./checkpoints/liveportrait_animal_onnx/warping_spade-fix-v1.1.onnx
+/root/miniconda3/bin/python scripts/onnx2trt.py -o ./checkpoints/liveportrait_animal_onnx/warping_spade-fix-v1.1.onnx
 # motion_extractor model
-python scripts/onnx2trt.py -o ./checkpoints/liveportrait_animal_onnx/motion_extractor-v1.1.onnx -p fp32
+/root/miniconda3/bin/python scripts/onnx2trt.py -o ./checkpoints/liveportrait_animal_onnx/motion_extractor-v1.1.onnx -p fp32
 # appearance_extractor model
-python scripts/onnx2trt.py -o ./checkpoints/liveportrait_animal_onnx/appearance_feature_extractor-v1.1.onnx
+/root/miniconda3/bin/python scripts/onnx2trt.py -o ./checkpoints/liveportrait_animal_onnx/appearance_feature_extractor-v1.1.onnx
 # stitching model
-python scripts/onnx2trt.py -o ./checkpoints/liveportrait_animal_onnx/stitching-v1.1.onnx
-python scripts/onnx2trt.py -o ./checkpoints/liveportrait_animal_onnx/stitching_eye-v1.1.onnx
-python scripts/onnx2trt.py -o ./checkpoints/liveportrait_animal_onnx/stitching_lip-v1.1.onnx
+/root/miniconda3/bin/python scripts/onnx2trt.py -o ./checkpoints/liveportrait_animal_onnx/stitching-v1.1.onnx
+/root/miniconda3/bin/python scripts/onnx2trt.py -o ./checkpoints/liveportrait_animal_onnx/stitching_eye-v1.1.onnx
+/root/miniconda3/bin/python scripts/onnx2trt.py -o ./checkpoints/liveportrait_animal_onnx/stitching_lip-v1.1.onnx
